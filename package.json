{
  "name": "@extantape/payload-plugin-nested-docs-browser",
  "version": "0.2.2",
  "description": "Nested Docs Browser for Payload: browse large hierarchies in pages that adapt to how much is inside, with Show all on every shortened view, an A-Z index and saved groups over the tree.",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "nested-docs",
    "hierarchy",
    "tree",
    "taxonomy",
    "browse"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ExtantApe/payload-plugin-nested-docs-browser#readme",
  "bugs": {
    "url": "https://github.com/ExtantApe/payload-plugin-nested-docs-browser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExtantApe/payload-plugin-nested-docs-browser.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client/styles.css": "./dist/client/styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/write-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "payload": "^3.80.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "^3.92.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "graphql": "^16.15.0",
    "jsdom": "^31.0.0",
    "mongodb-memory-server": "^11.3.0",
    "payload": "^3.92.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
